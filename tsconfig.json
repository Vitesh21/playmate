{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@playmate/types": ["./packages/types/src/index.ts"],
      "@playmate/validation": ["./packages/validation/src/index.ts"],
      "@playmate/config": ["./packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
